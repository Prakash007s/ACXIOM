@model CustomerVm
@{ ViewData["Title"] = "Customer"; }
<div class="mb-4"><h1 class="page-title">@(Model.CustomerId == 0 ? "New" : "Edit") Customer</h1><p class="page-sub">Fields marked by validation must be completed</p></div>
<div class="card p-4" style="max-width:820px"><form asp-action="Save" method="post"><input type="hidden" asp-for="CustomerId"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="CustomerName"></label><input asp-for="CustomerName" class="form-control"><span asp-validation-for="CustomerName" class="text-danger small"></span></div>
<div class="col-md-6"><label asp-for="CompanyName"></label><input asp-for="CompanyName" class="form-control"></div>
<div class="col-md-6"><label asp-for="Email"></label><input asp-for="Email" class="form-control"><span asp-validation-for="Email" class="text-danger small"></span></div>
<div class="col-md-6"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control" placeholder="10-digit mobile"><span asp-validation-for="Phone" class="text-danger small"></span></div>
<div class="col-12"><label asp-for="Address"></label><input asp-for="Address" class="form-control"></div>
<div class="col-md-6"><label asp-for="City"></label><input asp-for="City" class="form-control"></div><div class="col-md-6"><label asp-for="State"></label><input asp-for="State" class="form-control"></div></div>
<div class="mt-4 d-flex gap-2"><button class="btn btn-primary px-4">Save</button><a asp-action="Index" class="btn btn-light">Cancel</a></div></form></div>
