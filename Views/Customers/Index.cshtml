@model List<Customer>
@{ ViewData["Title"] = "Customers"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="page-title">Customers</h1><p class="page-sub">@Model.Count record(s)</p></div>
<a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>New Customer</a></div>
<div class="card"><div class="p-3 border-bottom"><form class="position-relative" style="max-width:420px"><i class="bi bi-search position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
<input name="q" value="@ViewBag.Q" class="form-control ps-5" placeholder="Search name, email, phone, company"></form></div>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Code</th><th>Customer</th><th>Contact</th><th>Company</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>
@foreach (var c in Model) { <tr><td class="text-muted">@c.CustomerCode</td><td class="fw-semibold">@c.CustomerName</td><td>@c.Email<div class="text-muted small">@c.Phone</div></td><td>@c.CompanyName</td>
<td><span class="badge-s @(c.Status == "Active" ? "b-green" : "b-gray")">@c.Status</span></td><td class="text-end text-nowrap"><a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@c.CustomerId"><i class="bi bi-pencil"></i></a>
@if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Deactivate this customer?')"><button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></button></form> }</td></tr> }
@if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-5"><i class="bi bi-inbox fs-2 d-block"></i>No customers found</td></tr> }</tbody></table></div></div>
