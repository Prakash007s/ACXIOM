@model LoginVm
<div class="auth"><div class="auth-hero"><h1><i class="bi bi-diagram-3-fill me-2"></i>AcxiomCRM</h1><p class="fs-5 opacity-75">One place for customers, leads and your sales pipeline.</p>
<ul class="p-0 mt-4"><li><i class="bi bi-check-circle-fill"></i>Role-based access for every team member</li><li><i class="bi bi-check-circle-fill"></i>Live pipeline dashboards</li><li><i class="bi bi-check-circle-fill"></i>Full audit trail of every action</li></ul></div>
<div class="auth-form"><div><h3 class="fw-bold">Welcome back</h3><p class="text-muted mb-4">Sign in to your account</p>
<form asp-action="Login" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
<div class="mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control" placeholder="you@company.com"><span asp-validation-for="Email" class="text-danger small"></span></div>
<div class="mb-3"><label asp-for="Password"></label><input asp-for="Password" class="form-control" placeholder="••••••••"><span asp-validation-for="Password" class="text-danger small"></span></div>
<div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input"><label asp-for="RememberMe" class="form-check-label fw-normal"></label></div>
<button class="btn btn-primary w-100 py-2">Sign in</button></form><p class="text-center text-muted mt-4 mb-0">New here? <a asp-action="Register">Create an account</a></p></div></div></div>
